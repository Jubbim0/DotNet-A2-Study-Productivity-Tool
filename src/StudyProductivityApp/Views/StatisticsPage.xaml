<Page x:Class="StudyProductivityApp.Views.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Statistics"
      Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Statistics" Style="{StaticResource PageHeadingStyle}" Margin="0,0,0,16"/>
            <UniformGrid Columns="2" Margin="-5,0,-5,18">
                <Border Style="{StaticResource CardBorderStyle}" Margin="5">
                    <StackPanel><TextBlock Text="Total Study Time" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="TotalStudyTimeText" Text="0h 0m" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="5">
                    <StackPanel><TextBlock Text="Completed Sessions" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="CompletedSessionsText" Text="0" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="5">
                    <StackPanel><TextBlock Text="Average Duration" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="AverageDurationText" Text="0 min" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="5">
                    <StackPanel><TextBlock Text="Task Completion" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="TaskCompletionText" Text="0%" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock x:Name="NoStudySessionsText" Text="No study sessions recorded yet. Complete a focus session to see your study charts." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed"/>
            <TextBlock Text="Study Time by Category" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <charts:CartesianChart x:Name="CategoryChart" Height="280" MinWidth="300"/>
            </Border>
            <TextBlock Text="Daily Study Activity" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <charts:CartesianChart x:Name="DailyChart" Height="280" MinWidth="300"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>