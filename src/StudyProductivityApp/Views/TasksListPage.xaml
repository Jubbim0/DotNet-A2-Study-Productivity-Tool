<Page x:Class="StudyProductivityApp.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tasks"
      Style="{StaticResource PageStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Task management" Style="{StaticResource PageHeadingStyle}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.8*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Title" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TitleInput" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Description" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionInput" Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="Category" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryInput" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="Deadline" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DueDateInput" FontFamily="Segoe UI" FontSize="13" MinHeight="34"/>
                    </StackPanel>
                    <StackPanel Width="125" Margin="0,0,12,8">
                        <TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PriorityInput" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusInput" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="EditingTaskText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" Visibility="Collapsed"/>
                <WrapPanel>
                    <Button Content="Add Task" Style="{StaticResource PrimaryButtonStyle}" Click="AddTask_Click"/>
                    <Button x:Name="UpdateTaskButton" Content="Update Task" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="UpdateTask_Click"/>
                    <Button x:Name="DeleteTaskButton" Content="Delete Task" Style="{StaticResource DestructiveButtonStyle}" IsEnabled="False" Click="DeleteTask_Click"/>
                    <Button x:Name="CompleteTaskButton" Content="Mark Complete" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="CompleteTask_Click"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Filter and sort tasks" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <StackPanel Width="155" Margin="0,0,12,0">
                        <TextBlock Text="Category" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryFilter" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filter_Changed" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,0">
                        <TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PriorityFilter" SelectionChanged="Filter_Changed" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,0">
                        <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Sort by" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SortInput" SelectionChanged="Filter_Changed" Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="TasksGrid_SelectionChanged" Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category.Name, TargetNullValue=Uncategorised}" Width="130"/>
                        <DataGridTextColumn Header="Deadline" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TasksEmptyText" Text="No tasks match these filters. Add a task or adjust the filters." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>