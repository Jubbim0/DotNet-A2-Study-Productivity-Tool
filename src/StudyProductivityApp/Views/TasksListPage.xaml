<Page x:Class="StudyProductivityApp.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TasksPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Task form -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Task Management"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Task Title"/>
            <TextBox x:Name="TitleInput"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionInput"
                     Height="55"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,5,0,10"/>

            <WrapPanel Margin="0,0,0,10">

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Category"/>
                    <ComboBox x:Name="CategoryInput"
                              Width="150"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Deadline"/>
                    <DatePicker x:Name="DueDateInput"
                                Width="150"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Priority"/>
                    <ComboBox x:Name="PriorityInput"
                              Width="130"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Status"/>
                    <ComboBox x:Name="StatusInput"
                              Width="130"/>
                </StackPanel>

            </WrapPanel>

            <WrapPanel Margin="0,0,0,15">
                <Button Content="Add Task"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="AddTask_Click"/>

                <Button Content="Update Task"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="UpdateTask_Click"/>

                <Button Content="Delete Task"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="DeleteTask_Click"/>

                <Button Content="Mark Complete"
                        Width="110"
                        Margin="0,0,10,0"
                        Click="CompleteTask_Click"/>

                <Button Content="Clear"
                        Width="80"
                        Click="Clear_Click"/>
            </WrapPanel>

        </StackPanel>

        <!-- Filtering and sorting -->
        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,15">

            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="Filter Category"/>
                <ComboBox x:Name="CategoryFilter"
                          Width="150"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="Filter Priority"/>
                <ComboBox x:Name="PriorityFilter"
                          Width="130"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="Filter Status"/>
                <ComboBox x:Name="StatusFilter"
                          Width="130"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Sort By"/>
                <ComboBox x:Name="SortInput"
                          Width="150"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>

        </WrapPanel>

        <!-- Task list -->
        <DataGrid x:Name="TasksGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="TasksGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Title"
                                    Binding="{Binding Title}"
                                    Width="*"/>

                <DataGridTextColumn Header="Category"
                                    Binding="{Binding Category.Name}"
                                    Width="130"/>

                <DataGridTextColumn Header="Deadline"
                                    Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}"
                                    Width="110"/>

                <DataGridTextColumn Header="Priority"
                                    Binding="{Binding Priority}"
                                    Width="90"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="110"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Page>