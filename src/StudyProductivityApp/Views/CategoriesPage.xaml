<Page x:Class="StudyProductivityApp.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudyProductivityApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoriesPage">

    <Grid Margin="20">
      <StackPanel>

        <TextBlock Text="Categories"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,20" />

        <TextBlock Text="Category Name"/>

        <TextBox x:Name="CategoryNameTextBox"
                 Width="250"
                 HorizontalAlignment="Left"
                 Margin="0,5,0,10" />

        <Button x:Name="AddCategoryButton"
                Content="Add Category"
                Width="120"
                HorizontalAlignment="Left"
                Margin="0,0,0,20"
                Click="AddCategoryButton_Click"/> 

        <ListBox x:Name="CategoriesListBox"
                 Width="400"
                 Height="200"
                 HorizontalAlignment="Left"/>

        
      </StackPanel>
    </Grid>
</Page>
