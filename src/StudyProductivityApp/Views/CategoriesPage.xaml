<Page x:Class="StudyProductivityApp.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" Title="Categories" Style="{StaticResource PageStyle}">
  <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Categories" Style="{StaticResource PageHeadingStyle}" Margin="0,0,0,16"/>
    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20"><StackPanel>
      <TextBlock Text="Category details" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,12"/>
      <WrapPanel VerticalAlignment="Bottom">
        <StackPanel Width="230" Margin="0,0,16,8"><TextBlock Text="Category name" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/><TextBox x:Name="CategoryNameInput" MaxLength="100" Style="{StaticResource TextBoxStyle}"/></StackPanel>
        <StackPanel Width="155" Margin="0,0,16,8"><TextBlock Text="Colour (hex)" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,5"/><DockPanel LastChildFill="True"><Border x:Name="CategoryColourPreview" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#808080" ToolTip="Colour preview"/><TextBox x:Name="CategoryColourInput" Text="#808080" MaxLength="7" TextChanged="CategoryColourInput_TextChanged" Style="{StaticResource TextBoxStyle}"/></DockPanel></StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,4,0,0"><Button x:Name="AddCategoryButton" Content="Add Category" Style="{StaticResource PrimaryButtonStyle}" Click="AddCategory_Click"/><Button x:Name="UpdateCategoryButton" Content="Update Category" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="UpdateCategory_Click"/><Button x:Name="DeleteCategoryButton" Content="Delete Category" Style="{StaticResource DestructiveButtonStyle}" IsEnabled="False" Click="DeleteCategory_Click"/><Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click"/></WrapPanel>
    </StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="170"/><ColumnDefinition Width="3*" MinWidth="250"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,12"><StackPanel>
        <TextBlock Text="Your categories" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4"/><TextBlock Text="Select a category to manage its tasks." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"/>
        <Grid Height="190"><DataGrid x:Name="CategoriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CategoriesGrid_SelectionChanged" Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTemplateColumn Header="Colour" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="20" Height="20" Fill="{Binding Colour}" Stroke="{StaticResource SubtleBorderBrush}" StrokeThickness="1" ToolTip="{Binding Colour}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="CategoriesEmptyText" Text="No categories yet. Add one above." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      </StackPanel></Border>
      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Tasks in selected category" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10"/><Grid Height="110"><DataGrid x:Name="AssociatedTasksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="TaskGrid_SelectionChanged" Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}"><DataGrid.Columns><DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="AssociatedTasksEmptyText" Text="Select a category to see its tasks." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button x:Name="RemoveTaskButton" Content="Remove selected task from category" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" IsEnabled="False" Click="RemoveTaskFromCategory_Click"/></StackPanel></Border>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Unassigned tasks" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10"/><Grid Height="110"><DataGrid x:Name="AvailableTasksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="TaskGrid_SelectionChanged" Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}"><DataGrid.Columns><DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="AvailableTasksEmptyText" Text="No unassigned tasks are available." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button x:Name="AddTaskButton" Content="Add selected task to category" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" IsEnabled="False" Click="AddTaskToCategory_Click"/></StackPanel></Border>
      </StackPanel>
    </Grid>
  </StackPanel></ScrollViewer>
</Page>
