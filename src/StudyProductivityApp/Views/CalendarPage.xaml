<Page x:Class="StudyProductivityApp.Views.CalendarPage"
	 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	 Title="CalendarPage"
	 Background="#F5F6FA">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Page heading -->
		<TextBlock Grid.Row="0"
                   Text="Calendar"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

		<!-- Main content -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Left: Calendar -->
			<Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

				<Viewbox Stretch="Uniform"
                         StretchDirection="Both">

					<Calendar x:Name="StudyCalendar"
                              SelectionMode="SingleDate"
                              SelectedDatesChanged="StudyCalendar_SelectedDatesChanged"/>

				</Viewbox>

			</Border>

			<!-- Right: Tasks for selected date -->
			<Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock x:Name="SelectedDateText"
               Grid.Row="0"
               Text="Tasks for selected date"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,20"/>

					<DataGrid x:Name="TasksDataGrid"
              Grid.Row="1"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              Margin="0,5,0,0">

						<DataGrid.Columns>
							<DataGridTextColumn Header="Task"
                                Binding="{Binding Title}"
                                Width="*"/>

							<DataGridTextColumn Header="Priority"
                                Binding="{Binding Priority}"
                                Width="Auto"/>

							<DataGridTextColumn Header="Status"
                                Binding="{Binding Status}"
                                Width="Auto"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

			</Border>
		</Grid>
	</Grid>
</Page>