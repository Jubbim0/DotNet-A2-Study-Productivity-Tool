<Page x:Class="StudyProductivityApp.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Calendar"
      Style="{StaticResource PageStyle}">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Calendar" Style="{StaticResource PageHeadingStyle}" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.4*" MinWidth="240"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" MinHeight="330">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Calendar x:Name="StudyCalendar" SelectionMode="SingleDate" SelectedDatesChanged="StudyCalendar_SelectedDatesChanged"/>
                    </Viewbox>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" MinHeight="330">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="220"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SelectedDateText" Grid.Row="0" Text="Tasks for selected date" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="TasksDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="Auto"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="CalendarTasksEmptyText" Text="No tasks due on this date." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>