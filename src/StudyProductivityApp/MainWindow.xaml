<Window x:Class="StudyProductivityApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Productivity App"
        Height="650"
        Width="950"
        MinHeight="500"
        MinWidth="750"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <StackPanel Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    KeyboardNavigation.TabNavigation="Local">

            <TextBlock Text="Study Productivity"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="18,22,14,18"/>

            <Button x:Name="CategoriesNavigationButton"
                    Content="Categories"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Categories_Click"/>

            <Button x:Name="TasksNavigationButton"
                    Content="Tasks"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Tasks_Click"/>

            <Button x:Name="FocusNavigationButton"
                    Content="Focus Sessions"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Focus_Click"/>

            <Button x:Name="CalendarNavigationButton"
                    Content="Calendar"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Calendar_Click"/>

            <Button x:Name="StatisticsNavigationButton"
                    Content="Statistics"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Statistics_Click"/>

        </StackPanel>

        <!-- Page content -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>