<Window x:Class="StudyProductivityApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Productivity App"
        Height="650"
        Width="950"
        MinHeight="500"
        MinWidth="750">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <StackPanel Grid.Column="0"
                    Background="#EEEEEE">

            <TextBlock Text="Study Productivity"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="15,15"/>

            <Button Content="Categories"
                    Height="40"
                    Click="Categories_Click"/>

            <Button Content="Tasks"
                    Height="40"
                    Click="Tasks_Click"/>

            <Button Content="Focus Sessions"
                    Height="40"
                    Click="Focus_Click"/>

            <Button Content="Calendar"
                    Height="40"
                    Click="Calendar_Click"/>

            <Button Content="Statistics"
                    Height="40"
                    Click="Statistics_Click"/>

        </StackPanel>

        <!-- Page content -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>